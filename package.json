{
  "name": "youtube-2d-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:storyboard": "remotion studio src/storyboard-index.ts",
    "render:storyboard": "node --import tsx scripts/render-storyboard.ts",
    "verify:storyboard": "node --import tsx scripts/verify-storyboard.ts",
    "check:compatibility": "node --import tsx scripts/check-compatibility.ts",
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render": "tsx scripts/render.ts",
    "review": "tsx scripts/review.ts",
    "review:sun": "tsx scripts/review-sun.ts",
    "review:planet": "tsx scripts/review-planet.ts",
    "review:polish": "tsx scripts/review-polish.ts",
    "verify": "tsx scripts/verify.ts",
    "story:validate": "node --env-file-if-exists=.env --import tsx scripts/story.ts validate",
    "story:preview": "node --env-file-if-exists=.env --import tsx scripts/story.ts preview",
    "story:render": "node --env-file-if-exists=.env --import tsx scripts/story.ts render",
    "story:prepare": "node --env-file-if-exists=.env --import tsx scripts/story.ts prepare",
    "story:auth": "node --env-file-if-exists=.env --import tsx scripts/story.ts auth --tts elevenlabs",
    "story:render-cached": "node --import tsx scripts/render-cached-story.ts",
    "story:verify-cached": "node --import tsx scripts/verify-cached-story.ts",
    "narration:synthesize": "node --env-file-if-exists=.env --import tsx scripts/synthesize-narration.ts",
    "preview:stills": "node --import tsx scripts/preview-stills.ts",
    "anchors:check": "node --import tsx scripts/check-anchor-sync.ts",
    "storyboard:draft": "node --import tsx scripts/draft-storyboard.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/bundler": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  }
}
